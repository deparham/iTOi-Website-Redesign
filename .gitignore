# Ignore general WordPress files
wp-config.php
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
/.htaccess
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
*.sql
*.log

# Ignore specific WordPress directories
/wp-admin/
/wp-includes/

# Ignore development files
/node_modules/
/package-lock.json
/yarn.lock
/gruntfile.js
/gulpfile.js
/.babelrc
/.eslintrc
wp-content/updraft/
*.zip.tmp
*.tmp

# Third-party premium plugins
/wp-content/plugins/advanced-custom-fields-pro/

# WordPress uploads (media) — not tracked in git
/wp-content/uploads/

# All third-party plugin source — none of this is ITOI-owned code, and
# committing it (especially anything with embedded credentials/license
# keys, see NOTES.md 2026-08-05) is not this repo's job. Managed via a
# documented per-plugin install/update process instead.
/wp-content/plugins/

# Security-plugin backup output — can contain a full wp-config.php
# snapshot (real DB credentials + WordPress secret salts), confirmed via
# a real exposed instance found in this repo's own history (see
# NOTES.md 2026-08-05).
/wp-content/aiowps_backups/
